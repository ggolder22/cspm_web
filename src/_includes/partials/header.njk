{#-
  HEADER / MENÚ PRINCIPAL
  Se genera desde src/_data/navigation.js. Los textos salen de t.labels.
  - Desktop: submenús desplegables con :hover / :focus-within (sin JS).
  - Mobile: el botón [data-nav-toggle] abre el panel (js/modules/nav.js).
  Un ítem queda activo si su página está en la ruta actual (breadcrumbs).
-#}
{% import "components/ui.njk" as ui %}
<header class="site-header" data-header>
  <div class="site-header__inner">

    <a class="brand" href="{{ 'home' | link(locale) }}" aria-label="{{ site.name }} — {{ t.labels.home }}">
      {% include "partials/logo.njk" %}<span class="brand__name">{{ site.name }}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
            data-nav-toggle data-label-open="{{ t.nav.menu }}" data-label-close="{{ t.nav.close }}">
      <span class="sr-only">{{ t.nav.menu }}</span>{{ ui.icon('menu', 24) }}
    </button>

    <nav class="site-nav" id="site-nav" aria-label="{{ t.nav.main }}" data-nav>
      <ul class="site-nav__list">
        {% for item in navigation.main %}
        {%- set isActive = item.link in breadcrumbs -%}
        <li class="site-nav__item{% if item.children %} has-children{% endif %}">
          <a class="site-nav__link{% if isActive %} is-active{% endif %}" href="{{ item.link | link(locale) }}"
             {%- if item.link == pageKey %} aria-current="page"{% endif %}>
            {{ t.labels[item.label or item.link] }}
            {% if item.children %}{{ ui.icon('chevron-down', 14) }}{% endif %}
          </a>
          {% if item.children %}
          <ul class="site-nav__sub">
            {% for child in item.children %}
            <li><a href="{{ child.link | link(locale) }}"{% if child.link == pageKey %} aria-current="page"{% endif %}>{{ t.labels[child.label or child.link] }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>

      <div class="site-nav__actions">
        <div class="lang-switch" role="group" aria-label="{{ t.nav.language }}">
          {% for lang in languageLinks %}
          <a class="lang-switch__btn{% if lang.current %} is-active{% endif %}" href="{{ lang.url }}" hreflang="{{ lang.locale }}"
             lang="{{ lang.locale }}"{% if lang.current %} aria-current="true"{% endif %}>{{ lang.locale | upper }}</a>
          {% endfor %}
        </div>
        {{ ui.button(t.nav.contact, 'contacto' | link(locale), 'primary') }}
      </div>
    </nav>

  </div>
</header>

{#-
  SECCIÓN: FORMULARIO DE CONTACTO Y REGISTRO COMERCIAL
  { type: 'contact', id, theme }
  Los textos salen de t.form (i18n.js). El envío lo maneja
  js/modules/contact-form.js → POST /api/contact (api/contact.js).
  El botón de WhatsApp arma el mensaje con los datos cargados.
  La unidad se puede preseleccionar con ?unidad=<clave> en la URL.
-#}
{% import "components/ui.njk" as ui %}
{%- set f = t.form -%}
{% call ui.section(section, 'contact', false) %}
<div class="contact">

  <div class="contact__info">
    <h2 class="section-title">{{ f.title }}</h2>
    <p class="section-intro">{{ f.intro }}</p>
    <h3 class="contact__subtitle">{{ f.directTitle }}</h3>
    {% include "partials/contact-links.njk" %}
  </div>

  <form class="form" data-contact-form data-whatsapp="{{ site.contact.whatsapp }}" novalidate>
    <div class="form__row">
      <label class="field">
        <span>{{ f.name }} *</span>
        <input name="name" autocomplete="name" required maxlength="120">
      </label>
      <label class="field">
        <span>{{ f.company }} <small>({{ f.optional }})</small></span>
        <input name="company" autocomplete="organization" maxlength="120">
      </label>
    </div>

    <div class="form__row">
      <label class="field">
        <span>{{ f.email }} *</span>
        <input name="email" type="email" autocomplete="email" required maxlength="160">
      </label>
      <label class="field">
        <span>{{ f.phone }} <small>({{ f.optional }})</small></span>
        <input name="phone" type="tel" autocomplete="tel" maxlength="40">
      </label>
    </div>

    <div class="form__row">
      <label class="field">
        <span>{{ f.unit }} *</span>
        <select name="unit" required>
          {% for key, label in f.units %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
        </select>
      </label>
      <label class="field">
        <span>{{ f.profile }} *</span>
        <select name="profile" required>
          {% for key, label in f.profiles %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
        </select>
      </label>
    </div>

    <label class="field">
      <span>{{ f.message }} *</span>
      <textarea name="message" rows="5" required maxlength="3000" placeholder="{{ f.messagePlaceholder }}"></textarea>
    </label>

    {#- Campo trampa anti-spam: invisible para personas, los bots lo completan -#}
    <label class="form__trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>

    <input type="hidden" name="locale" value="{{ locale }}">

    <div class="form__actions">
      <button class="btn btn--primary" type="submit" data-label-sending="{{ f.sending }}">{{ ui.icon('mail', 16) }}<span>{{ f.submit }}</span></button>
      <button class="btn btn--whatsapp" type="button" data-whatsapp-send>{{ ui.icon('whatsapp', 16) }}<span>{{ f.whatsapp }}</span></button>
    </div>

    <p class="form__status" role="status" aria-live="polite" data-form-status
       data-msg-success="{{ f.success }}"
       data-msg-error="{{ f.error }} {{ site.contact.email }}"
       data-msg-required="{{ f.required }}"></p>
  </form>

</div>
{% endcall %}

{#-
  SECCIÓN: LÍNEA DE TIEMPO (historia, hoja de ruta, estado de desarrollo)
  {
    type: 'timeline',
    id, theme, tag, title, intro, align,
    items: [{ icon, date, title, text, status: 'done' | 'current' | 'next' }]
  }
  `status` es opcional: resalta la etapa actual y atenúa las futuras.
-#}
{% import "components/ui.njk" as ui %}
{% call ui.section(section, 'timeline') %}
<ol class="timeline">
  {% for item in section.items %}
  <li class="timeline__item{% if item.status %} is-{{ item.status }}{% endif %} reveal" style="--i: {{ loop.index0 }}">
    <span class="timeline__dot" aria-hidden="true">{{ item.icon }}</span>
    <div>
      <p class="timeline__date">{{ item.date }}</p>
      <h3>{{ item.title }}</h3>
      <p>{{ item.text | safe }}</p>
    </div>
  </li>
  {% endfor %}
</ol>
{% endcall %}

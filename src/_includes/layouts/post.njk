---
layout: layouts/base.njk
---
{#-
  ============================================================================
  LAYOUT DE ARTÍCULO DEL BLOG
  Front matter del .md: title, date, excerpt, image (opcional), tags
  ============================================================================
-#}
<article class="post">
  <header class="post__header container">
    <p class="post__meta">
      <time datetime="{{ date | dateISO }}">{{ date | dateLocal(locale) }}</time>
      {% for tag in tags %}<span class="pill">{{ tag }}</span>{% endfor %}
    </p>
    <h1 class="post__title">{{ title }}</h1>
    {% if excerpt %}<p class="post__excerpt">{{ excerpt }}</p>{% endif %}
    {% if image %}<img class="post__image" src="{{ image }}" alt="" loading="eager">{% endif %}
  </header>

  <div class="post__body container">
    {{ content | safe }}
  </div>

  <footer class="post__footer container">
    <div class="post__author">
      <span class="post__avatar" aria-hidden="true">GG</span>
      <p><strong>{{ site.founder }}</strong><br>{{ t.blog.authorRole }}</p>
    </div>
    <a class="text-link" href="{{ 'blog' | link(locale) }}">{{ t.blog.back }}</a>
  </footer>
</article>

{% include "partials/cta.njk" %}
